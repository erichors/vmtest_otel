# ---------------------------------------------------------------------------
# checkout-java tier configuration.
#
# Copied by install/01-provision-host.sh to /etc/dtdemo/java.env and loaded
# via EnvironmentFile= in install/systemd/dtdemo-java.service.
#
# DB_URL / DB_USER / DB_PASSWORD and PRICING_URL map directly to the
# ${DB_URL}, ${DB_USER}, ${DB_PASSWORD}, ${PRICING_URL} placeholders in
# java-tier/src/main/resources/application.yml.
# ---------------------------------------------------------------------------

# --- Database ----------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/dtdemo
DB_USER=dtdemo
DB_PASSWORD=dtdemo

# --- Location of the pricing-python tier -------------------------------------
PRICING_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# OpenTelemetry (read by the OpenTelemetry Java agent attached via -javaagent
# in dtdemo-java.service - this app has no OTel SDK dependency of its own).
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=checkout-java
OTEL_RESOURCE_ATTRIBUTES=service.name=checkout-java,service.version=1.0.0,deployment.environment=demo
OTEL_TRACES_EXPORTER=otlp

# OneAgent (infra-only) already reports host metrics and tails this
# process's logs via log monitoring - turn the OTel metrics/logs exporters
# off so nothing is duplicated or fighting over the same signal.
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:14499/otlp/v1/traces

# The OneAgent Extension Execution Controller endpoint does NOT support
# Content-Encoding on this port - compression MUST be off or every export
# POST will be rejected.
OTEL_EXPORTER_OTLP_TRACES_COMPRESSION=none

OTEL_PROPAGATORS=tracecontext,baggage

# always_on so every transaction the load generator drives produces a
# complete, visible trace during the demo - no head-based sampling to
# fight with while you're presenting.
OTEL_TRACES_SAMPLER=always_on

# Populates trace_id/span_id into the logback MDC (consumed by the
# %X{trace_id} / %X{span_id} pattern in application.yml's logging.pattern.console),
# so Dynatrace log monitoring can correlate log lines with the span that emitted them.
OTEL_INSTRUMENTATION_LOGBACK_MDC_ENABLED=true
