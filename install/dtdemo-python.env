# ---------------------------------------------------------------------------
# pricing-python tier configuration.
#
# Copied by install/01-provision-host.sh to /etc/dtdemo/python.env and loaded
# via EnvironmentFile= in install/systemd/dtdemo-python.service.
#
# DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD map directly to the
# os.environ.get(...) calls at the top of python-tier/app.py.
# ---------------------------------------------------------------------------

# --- Database ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dtdemo
DB_USER=dtdemo
DB_PASSWORD=dtdemo

# ---------------------------------------------------------------------------
# OpenTelemetry - consumed by `opentelemetry-instrument`, which wraps gunicorn
# (see python-tier/gunicorn.conf.py) and configures the global TracerProvider
# + OTLP exporter *before* app.py's module-level code runs. app.py only grabs
# the already-configured tracer to add its two manual spans
# (compute_discount, check_inventory) - it never builds its own exporter.
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=pricing-python
OTEL_RESOURCE_ATTRIBUTES=service.name=pricing-python,service.version=1.0.0,deployment.environment=demo
OTEL_TRACES_EXPORTER=otlp

# OneAgent (infra-only) already reports host metrics and tails this
# process's stdout via log monitoring - turn the OTel metrics/logs exporters
# off so nothing is duplicated or fighting over the same signal.
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:14499/otlp/v1/traces

# The OneAgent Extension Execution Controller endpoint does NOT support
# Content-Encoding on this port - compression MUST be off or every export
# POST will be rejected.
OTEL_EXPORTER_OTLP_TRACES_COMPRESSION=none

OTEL_PROPAGATORS=tracecontext,baggage

# always_on so every transaction the load generator drives produces a
# complete, visible trace during the demo - no head-based sampling to
# fight with while you're presenting.
OTEL_TRACES_SAMPLER=always_on

# Ties Python's logging module (used throughout app.py via logging.getLogger)
# into the active span context so log lines carry trace/span ids.
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
